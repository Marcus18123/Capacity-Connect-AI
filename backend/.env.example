# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=dev_secret_key_change_me_in_production_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
